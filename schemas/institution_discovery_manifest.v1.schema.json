{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-pool.local/schemas/institution_discovery_manifest.v1.schema.json",
  "title": "Institution Discovery Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_version",
    "institution_id",
    "checked_at",
    "baseline_tag",
    "identity",
    "scope",
    "sources",
    "academic_units",
    "coverage",
    "adapter_assessment"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_version": {"type": "integer", "minimum": 1},
    "institution_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "checked_at": {"type": "string", "format": "date"},
    "baseline_tag": {"type": "string", "minLength": 1},
    "identity": {
      "type": "object",
      "required": ["official_name", "ror_id", "homepage_url", "official_domains"],
      "properties": {
        "official_name": {"type": "string", "minLength": 1},
        "ror_id": {"type": "string", "pattern": "^https://ror\\.org/[0-9a-z]{9}$"},
        "homepage_url": {"type": "string", "format": "uri"},
        "official_domains": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "type",
        "name",
        "population",
        "inclusion_rule",
        "exclusions",
        "membership_policy",
        "research_unit_policy"
      ],
      "properties": {
        "type": {"const": "institution"},
        "name": {"type": "string", "minLength": 1},
        "population": {"const": "academic_and_research_personnel"},
        "inclusion_rule": {"type": "string", "minLength": 1},
        "exclusions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "membership_policy": {"type": "string", "minLength": 1},
        "research_unit_policy": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "role",
          "url",
          "official",
          "access_state",
          "observed_http_status"
        ],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "role": {
            "enum": [
              "organizational_scope",
              "people_directory",
              "research_profile",
              "research_degree",
              "programme_information"
            ]
          },
          "url": {"type": "string", "format": "uri"},
          "official": {"const": true},
          "access_state": {
            "enum": ["reachable", "browser_only", "transport_error", "not_probed"]
          },
          "observed_http_status": {"type": ["integer", "null"]},
          "note": {"type": "string"}
        }
      }
    },
    "academic_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["unit_id", "name", "unit_type", "scope_status", "evidence_source_id"],
        "properties": {
          "unit_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "name": {"type": "string", "minLength": 1},
          "unit_type": {
            "enum": ["faculty", "college", "school", "academy", "institute", "cross_faculty_school"]
          },
          "scope_status": {"enum": ["include", "include_with_deduplication"]},
          "evidence_source_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "unit_inventory_granularity",
        "top_level_unit_count",
        "all_top_level_units_accounted_for",
        "people_source_present",
        "research_degree_evidence_present",
        "discovery_status",
        "adapter_readiness"
      ],
      "properties": {
        "unit_inventory_granularity": {"const": "top_level_and_cross_faculty_academic_units"},
        "top_level_unit_count": {"type": "integer", "minimum": 1},
        "all_top_level_units_accounted_for": {"const": true},
        "people_source_present": {"const": true},
        "research_degree_evidence_present": {"const": true},
        "discovery_status": {"const": "complete"},
        "adapter_readiness": {"enum": ["ready", "conditional"]}
      }
    },
    "adapter_assessment": {
      "type": "object",
      "required": ["coverage_strategy", "template_hypotheses", "known_constraints", "next_step"],
      "properties": {
        "coverage_strategy": {"type": "string", "minLength": 1},
        "template_hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source_id", "template_family", "confidence"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "template_family": {"type": "string", "minLength": 1},
              "confidence": {"enum": ["low", "medium", "high"]}
            }
          }
        },
        "known_constraints": {
          "type": "array",
          "items": {"type": "string"}
        },
        "next_step": {"type": "string", "minLength": 1}
      }
    }
  }
}
