{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-pool.local/schemas/pi_record.v1.schema.json",
  "title": "Canonical PI Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "person_id", "display_name", "given_name", "family_name",
    "aliases", "institution_id", "institution_name", "ror_id", "department",
    "title", "profile_url", "lab_url", "emails", "research_areas",
    "publications_summary", "external_ids",
    "source_evidence_ids", "last_checked_at", "contact_confidence",
    "topic_match_confidence", "current_affiliation_confidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "person_id": {"type": "string", "pattern": "^pi_[a-f0-9]{16}$"},
    "display_name": {"type": "string", "minLength": 1},
    "given_name": {"type": ["string", "null"]},
    "family_name": {"type": ["string", "null"]},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "institution_id": {"type": "string", "minLength": 1},
    "institution_name": {"type": "string", "minLength": 1},
    "ror_id": {"type": ["string", "null"]},
    "department": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "profile_url": {"type": ["string", "null"]},
    "lab_url": {"type": ["string", "null"]},
    "emails": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "research_areas": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "publications_summary": {"type": "object"},
    "external_ids": {"type": "object"},
    "source_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "last_checked_at": {"type": "string", "minLength": 1},
    "contact_confidence": {"enum": ["none", "low", "medium", "high", "unknown"]},
    "topic_match_confidence": {"enum": ["none", "low", "medium", "high", "unknown"]},
    "current_affiliation_confidence": {"enum": ["none", "low", "medium", "high", "unknown"]}
  }
}
